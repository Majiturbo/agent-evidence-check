{
  "name": "@majiturbo/deploy-check",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Evidence before agent judgments settle: direction, loop escape, done (anti test-wash), and deploy. Thin opt-in hooks for Cursor, Claude Code, Codex, Trae, Copilot, Qoder, DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "deploy-check": "bin/check-deploy.mjs",
    "deploy-check-install-hooks": "scripts/install-hooks.mjs",
    "deploy-check-mcp": "bin/deploy-check-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "scripts/install-hooks.mjs",
    "examples",
    "docs/rules",
    "docs/adapters.md",
    "docs/hook-setup.md",
    "docs/verify.md",
    "docs/judgments.md",
    "docs/mcp.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "check-deploy": "node bin/check-deploy.mjs",
    "mcp": "node bin/deploy-check-mcp.mjs",
    "install-hooks": "node scripts/install-hooks.mjs"
  },
  "keywords": [
    "agent",
    "evidence",
    "direction",
    "loop",
    "deploy",
    "hooks",
    "mcp",
    "cursor",
    "claude-code",
    "codex",
    "trae",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majiturbo/deploy-check.git"
  },
  "bugs": {
    "url": "https://github.com/Majiturbo/deploy-check/issues"
  },
  "homepage": "https://github.com/Majiturbo/deploy-check#readme"
}
