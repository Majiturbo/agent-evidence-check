{
  "name": "agent-evidence-check",
  "version": "0.2.1",
  "description": "Evidence checks for coding agents—direction, repair-loop escape, done/test receipts (anti test-wash), deploy verify. CLI + MCP + opt-in hooks for Cursor, Claude Code, Codex, Trae, Copilot, Qoder, DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-evidence-check": "bin/agent-evidence-check.mjs",
    "agent-evidence-check-install-hooks": "scripts/install-hooks.mjs",
    "agent-evidence-check-mcp": "bin/agent-evidence-check-mcp.mjs",
    "deploy-check": "bin/agent-evidence-check.mjs",
    "deploy-check-install-hooks": "scripts/install-hooks.mjs",
    "deploy-check-mcp": "bin/agent-evidence-check-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "hooks",
    "scripts/install-hooks.mjs",
    "examples",
    "docs/rules",
    "docs/adapters.md",
    "docs/hook-setup.md",
    "docs/verify.md",
    "docs/judgments.md",
    "docs/mcp.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "cli": "node bin/agent-evidence-check.mjs",
    "check-deploy": "node bin/agent-evidence-check.mjs",
    "mcp": "node bin/agent-evidence-check-mcp.mjs",
    "install-hooks": "node scripts/install-hooks.mjs"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "coding-agent",
    "llm",
    "evidence",
    "verification",
    "direction",
    "repair-loop",
    "test-wash",
    "deploy",
    "hooks",
    "agent-hooks",
    "mcp",
    "cursor",
    "claude-code",
    "codex",
    "trae",
    "copilot",
    "qoder",
    "deploy-check"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majiturbo/agent-evidence-check.git"
  },
  "bugs": {
    "url": "https://github.com/Majiturbo/agent-evidence-check/issues"
  },
  "homepage": "https://github.com/Majiturbo/agent-evidence-check#readme"
}
